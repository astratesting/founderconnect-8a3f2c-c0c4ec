# ── Backend ───────────────────────────────────────────────────────────────────
# Supabase connection string (use postgresql+asyncpg:// or postgres:// — auto-converted)
DATABASE_URL=postgresql://user:pass@db.xxxx.supabase.co:5432/postgres

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# Token lifetime in minutes (default 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# ── Clerk (OAuth: Google, GitHub, LinkedIn) ───────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
